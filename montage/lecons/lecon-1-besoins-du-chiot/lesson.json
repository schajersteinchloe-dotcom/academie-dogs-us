      { "text": "Pas que de l'industriel", "kind": "alert", "at": "w:l'industriel" }
    ] },
    { "tag": "3 · Jeu", "at": "w:Maintenant troisième point", "cards": [
      { "text": "10 à 15 min maximum", "at": "w:10 à 15" },
      { "text": "Pas 45 min de course", "kind": "alert", "at": "w:45" },
      { "text": "Stop quand l'excitation monte", "at": "w:l'excitation" },
      { "text": "C'est toi qui gères le rythme", "at": "w:contrôler" },
      { "text": "Lui apprendre à se calmer", "at": "w:se calmer" },
      { "text": "Une corde, une balle : c'est tout", "at": "w:une corde" },
      { "text": "100 % avec lui, sans téléphone", "at": "w:100%" }
