    { "tag": "4 · Propreté", "at": "w:Quatrième point", "cards": [
      { "text": "Il ne peut pas se retenir", "at": "w:physiquement" },
      { "text": "Sphincter pas encore mature", "at": "w:sphincter" },
      { "text": "Pas de la mauvaise volonté", "kind": "alert", "at": "w:mauvaise volonté" },
      { "text": "Sortir après chaque repas", "at": "w:après chaque repas" },
      { "text": "Après chaque sieste et jeu", "at": "w:après chaque sieste" },
      { "text": "Et toutes les 2-3 h", "at": "w:toutes les 2-3" },
      { "text": "Tout est dans l'anticipation", "kind": "arrow", "at": "w:retiens" }
