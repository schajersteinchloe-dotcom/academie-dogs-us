      { "text": "De 2 à 4 mois", "at": "w:quatre mois" },
      { "text": "Sommeil, repas, jeu, propreté…", "at": "w:aborder" }
    ] },
    { "tag": "1 · Sommeil", "at": "w:Premier point", "cards": [
      { "text": "16 à 18 h par jour", "at": "w:16 à 18" },
      { "text": "C'est là qu'il apprend le plus", "at": "w:apprend le plus" },
      { "text": "Ne jamais le réveiller", "kind": "alert", "at": "w:réveiller" },
      { "text": "Épuisé = agité", "at": "w:épuisé" },
      { "text": "A-t-il assez dormi ?", "kind": "arrow", "at": "w:assez dormi" },
      { "text": "Un coin calme, à l'écart", "at": "w:Aménage" }
    ] },
    { "tag": "2 · Nourriture", "at": "w:Deuxième besoin", "cards": [
      { "text": "2 à 3 repas par jour", "at": "w:2 à 3 fois" },
      { "text": "Des horaires fixes", "at": "w:horaires fixes" },
      { "text": "Propreté plus facile", "kind": "arrow", "at": "w:facilite" },
      { "text": "Les croquettes de l'élevage", "at": "w:poursuivre" },
