    { "tag": "5 · Socialisation", "at": "w:Et dernier point", "cards": [
      { "text": "Le laisser observer", "at": "w:observer" },
      { "text": "Sur un banc, au calme", "at": "w:sur un banc" },
      { "text": "Voitures, vélos, bruits, gens", "at": "w:les voitures" },
      { "text": "Regarder sans interagir", "at": "w:regarder" },
      { "text": "Sinon : peurs, réactivité", "kind": "alert", "at": "w:peurs" }
